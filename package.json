{
  "name": "care_zoom_fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Video appointments for CARE",
  "license": "MIT",
  "scripts": {
    "start": "concurrently -n 'build,serve' -c 'green.bold,blue.bold' \"npm run build:watch\" \"npm run preview\"",
    "build:watch": "nodemon",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:host": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:host:live": "CARE_REAL_BACKEND=1 playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-slot": "^1.2.2",
    "@tailwindcss/vite": "^4.1.4",
    "@zoom/videosdk": "2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react-i18next": "^15.4.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.4"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.2.6",
    "vitest": "^5.0.3"
  }
}
